# ===========================================================================
# D-Connect 환경 변수 템플릿
#
# 사용:
#   1) `cp .env.example .env`
#   2) 아래 값을 실제 값으로 채운다.
#
# 주의:
#   - `.env`는 gitignored. 절대 커밋하지 않는다.
#   - 운영/스테이징은 별도 시크릿 매니저로 관리한다.
# ===========================================================================

# --- Database (Prisma + SQLite) ---------------------------------------------
# 로컬 개발용 SQLite 파일 경로 (project root 기준). prisma/ 안에 두는 컨벤션.
# 운영 단계에서 PostgreSQL 등으로 마이그레이션 시 변경.
DATABASE_URL="file:./prisma/dev.db"

# --- OpenAI API (ADR-0002 추록 — 비용 사유로 Anthropic에서 전환, #92) --------
# https://platform.openai.com/api-keys 에서 발급. 키가 비어 있으면 mock 응답으로 폴백.
OPENAI_API_KEY=""

# --- LLM 모델 ID (ADR-0002) ------------------------------------------------
# OpenAI API의 현재 모델 ID로 채운다. 이후 변경 시 환경변수만 갱신.
# 예) gpt-4o-mini (저비용·빠름), gpt-4.1-mini, gpt-5-mini (품질 우선)
LLM_MODEL_DEFAULT="gpt-4o-mini"
LLM_MODEL_FAST="gpt-4o-mini"

# --- 인증 / NextAuth.js v5 (ADR-0004) ---------------------------------------
# 32바이트 이상 랜덤 문자열. 생성: `openssl rand -base64 32`
NEXTAUTH_SECRET=""
# AUTH_URL — 기본은 비워둔다 (localhost 자동 동작).
# ngrok 등 외부 도메인으로 소셜 로그인 시연 시에만 해당 origin으로 설정.
# 자세한 규칙: docs/OAUTH_SETUP.md 'ngrok에서 소셜 로그인'
# AUTH_URL="https://<내-ngrok-도메인>.ngrok-free.dev"

# --- 소셜 로그인 (카카오·구글) — 발급 절차: docs/OAUTH_SETUP.md ------------
# 키가 비어 있으면 해당 로그인 버튼이 자동으로 숨겨진다.

# Kakao (https://developers.kakao.com)
#   CLIENT_ID  = [앱] > [플랫폼 키] > 'REST API 키' (JavaScript 키 아님)
#   SECRET     = [플랫폼 키] > [REST API 키] > [클라이언트 시크릿] (활성화 상태 확인)
#   Redirect URI 등록(같은 화면): http://localhost:3000/api/auth/callback/kakao
#   [카카오 로그인] > [사용 설정] 상태 ON + [동의항목]에서 닉네임 필수 동의
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# Google (https://console.cloud.google.com > Google Auth Platform > Clients)
#   OAuth 클라이언트 (웹 애플리케이션) 생성 후 ID/보안 비밀번호 입력
#   리디렉션 URI 등록: http://localhost:3000/api/auth/callback/google
#   ⚠️ Audience(대상)의 '테스트 사용자'에 로그인할 구글 계정 등록 필요
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""""

# 이메일 인증 발송 (#86) — 셋업 가이드: docs/EMAIL_SETUP.md
#   미설정 시 mock fallback: 인증 링크를 화면·dev 콘솔에 표시 (시연 안전)
#   Gmail 예시 (앱 비밀번호 필요, @는 %40으로 인코딩):
#   EMAIL_SERVER="smtps://you%40gmail.com:앱비밀번호@smtp.gmail.com:465"
#   EMAIL_FROM="D-Connect <you@gmail.com>"
EMAIL_SERVER=""
EMAIL_FROM=""
