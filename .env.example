# ===========================================================================
# D-Connect 환경 변수 템플릿
#
# 사용:
#   1) `cp .env.example .env`
#   2) 아래 값을 실제 값으로 채운다.
#
# 주의:
#   - `.env`는 gitignored. 절대 커밋하지 않는다.
#   - 운영/스테이징은 별도 시크릿 매니저로 관리한다.
# ===========================================================================

# --- Database (Prisma + SQLite) ---------------------------------------------
# 로컬 개발용 SQLite 파일 경로 (project root 기준). prisma/ 안에 두는 컨벤션.
# 운영 단계에서 PostgreSQL 등으로 마이그레이션 시 변경.
DATABASE_URL="file:./prisma/dev.db"

# --- Anthropic Claude API (ADR-0002) ----------------------------------------
# https://console.anthropic.com 에서 발급. 키가 비어 있으면 mock 응답으로 폴백.
ANTHROPIC_API_KEY=""

# --- LLM 모델 ID (ADR-0002) ------------------------------------------------
# Anthropic API의 현재 모델 ID로 채운다. 이후 변경 시 환경변수만 갱신.
# 예) claude-sonnet-4-7-latest, claude-haiku-4-7-latest
LLM_MODEL_DEFAULT="claude-sonnet-4-7-latest"
LLM_MODEL_FAST="claude-haiku-4-7-latest"

# --- 인증 / NextAuth.js v5 (ADR-0004) ---------------------------------------
# 32바이트 이상 랜덤 문자열. 생성: `openssl rand -base64 32`
NEXTAUTH_SECRET=""
# 개발 환경 URL. 운영 시 https://...로 변경
NEXTAUTH_URL="http://localhost:3000"

# --- 소셜 로그인 (카카오·구글) — 발급 절차: docs/OAUTH_SETUP.md ------------
# 키가 비어 있으면 해당 로그인 버튼이 자동으로 숨겨진다.

# Kakao (https://developers.kakao.com)
#   CLIENT_ID  = [앱] > [플랫폼 키] > 'REST API 키' (JavaScript 키 아님)
#   SECRET     = [플랫폼 키] > [REST API 키] > [클라이언트 시크릿] (활성화 상태 확인)
#   Redirect URI 등록(같은 화면): http://localhost:3000/api/auth/callback/kakao
#   [카카오 로그인] > [사용 설정] 상태 ON + [동의항목]에서 닉네임 필수 동의
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# Google (https://console.cloud.google.com > Google Auth Platform > Clients)
#   OAuth 클라이언트 (웹 애플리케이션) 생성 후 ID/보안 비밀번호 입력
#   리디렉션 URI 등록: http://localhost:3000/api/auth/callback/google
#   ⚠️ Audience(대상)의 '테스트 사용자'에 로그인할 구글 계정 등록 필요
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""""

# Email Magic Link (ADR-0004 후속 — 1-B2에서 추가 결정 예정)
# EMAIL_SERVER=""
# EMAIL_FROM=""
