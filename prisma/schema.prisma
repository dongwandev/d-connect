// D-Connect DB 스키마
// 설계 의도는 docs/DB_SCHEMA.md, 의사결정 배경은 docs/adr/0001-tech-stack.md 참고.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  // Prisma 7: url은 prisma.config.ts에서 로딩 (dotenv 경유). schema에는 두지 않음.
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum SdgGoal {
  SDG_8 //  양질의 일자리와 경제성장
  SDG_11 // 지속가능한 도시와 공동체
  SDG_12 // 책임 있는 소비와 생산
  SDG_17 // 목표를 위한 파트너십
}

enum ContentType {
  SNS_POST //           SNS 게시글 (텍스트 완성형)
  CARD_NEWS //          카드뉴스 문안 (슬라이드 완성형)
  SHORT_VIDEO_SCRIPT // 숏폼 생성 프롬프트 (#92에서 영상 생성 AI용 프롬프트로 재정의)
  CAMPAIGN_SLOGAN //    캠페인 슬로건 (deprecated — 신규 생성 제외, 기존 데이터 표시용)
  POSTER //             포스터 (이미지 생성 AI용 프롬프트 + 문구, #92)
}

enum SocialCategory {
  EMPLOYMENT //    고용
  ENVIRONMENT //   환경
  LOCAL_ECONOMY // 지역경제
  COMMUNITY //     공동체
  COOPERATION //   협력
}

// --- D2 풍부한 폼 필드용 enum 5종 ---------------------------------------------

enum BusinessType {
  INDIVIDUAL //         개인사업자
  CORPORATION //        법인사업자
  SOCIAL_ENTERPRISE //  사회적기업
  COOPERATIVE //        협동조합
  OTHER //              기타
}

enum Sido {
  SEOUL //    서울특별시
  BUSAN //    부산광역시
  DAEGU //    대구광역시
  INCHEON //  인천광역시
  GWANGJU //  광주광역시
  DAEJEON //  대전광역시
  ULSAN //    울산광역시
  SEJONG //   세종특별자치시
  GYEONGGI // 경기도
  GANGWON //  강원특별자치도
  CHUNGBUK // 충청북도
  CHUNGNAM // 충청남도
  JEONBUK //  전북특별자치도
  JEONNAM //  전라남도
  GYEONGBUK// 경상북도
  GYEONGNAM// 경상남도
  JEJU //     제주특별자치도
}

enum IndustryCategory {
  FOOD_BEVERAGE //  식품·음료
  RETAIL //         소매·유통
  SERVICE //        서비스
  EDUCATION //      교육
  CULTURE_ARTS //   문화·예술
  ENVIRONMENT_IND// 환경 (산업 카테고리, SocialCategory.ENVIRONMENT와 별개)
  MANUFACTURING //  제조
  OTHER //          기타
}

enum TargetAudience {
  ALL //            전체
  YOUTH //          청년
  FAMILY //         가족
  SENIOR //         시니어
  LOCAL_RESIDENT // 지역주민
  OTHER //          기타
}

enum PromoGoal {
  BRAND_AWARENESS // 브랜드 인지도 향상
  PRODUCT_PROMO //   제품·서비스 홍보
  SALES_GROWTH //    판매·매출 증대
  LOCAL_AWARENESS // 지역사회 인식 개선
  INVESTMENT //      투자·후원 유치
  OTHER //           기타
}

// -----------------------------------------------------------------------------
// Auth.js (NextAuth v5) 표준 모델 — ADR-0004 / ADR-0005
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  /// 표시명(닉네임). 콘텐츠·댓글 등에 노출. 비어 있으면 realName 사용.
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// bcrypt 해시. 이메일/패스워드 회원만 채워짐 (OAuth/dev demo 회원은 NULL).
  password      String?

  /// 회원가입 시 받는 실명. KYC·결제 도입 시 활용.
  realName      String?
  /// 연락처 (010-xxxx-xxxx 형식 검증은 application 레이어).
  phone         String?
  /// 소속 단체/회사 (선택).
  organization  String?
  /// 이용약관·개인정보 처리방침 동의 시점 (필수 입력이므로 일반적으로 가입 시 설정됨).
  acceptedTermsAt DateTime?
  /// 마케팅 수신 동의 (선택).
  marketingOptIn  Boolean   @default(false)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  companies Company[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// 도메인 모델
// -----------------------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  /// 멀티테넌시 (ADR-0005): 본인 기업만 조회·수정. 일시 optional, 시드 후 application
  /// 레이어에서 항상 채워서 사용. 향후 NOT NULL로 알터 검토.
  userId    String?
  name      String
  /// 자유 텍스트 (deprecated — industryCategory로 대체. 기존 데이터 보존용)
  industry  String?
  /// 자유 텍스트 (deprecated — sido/sigungu로 대체)
  region    String?
  product   String?
  /// 자유 텍스트 (deprecated — promoGoal로 대체)
  purpose   String?

  // D2 신규 — 디자인 폼 필드
  foundedYear      Int?
  businessType     BusinessType?
  /// 시/도 enum
  sido             Sido?
  /// 시/군/구 자유 텍스트
  sigungu          String?
  industryCategory IndustryCategory?
  /// Deprecated — D6에서 다중 선택으로 전환. targetAudiences 사용.
  targetAudience   TargetAudience?
  /// Deprecated — D6에서 다중 선택으로 전환. promoGoals 사용.
  promoGoal        PromoGoal?
  /// TargetAudience[] JSON 직렬화 (다중 선택, D6)
  targetAudiences  String?
  /// PromoGoal[] JSON 직렬화 (다중 선택, D6)
  promoGoals       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]
  analyses   SdgAnalysis[]

  @@index([userId])
}

model Activity {
  id          String         @id @default(cuid())
  companyId   String
  category    SocialCategory
  title       String
  description String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model SdgAnalysis {
  id              String   @id @default(cuid())
  companyId       String
  /// SocialCategory[] JSON 직렬화 (SQLite 제약 — DB_SCHEMA §5.4)
  socialFunctions String
  publicMeaning   String
  /// mock fallback 발동 여부 (운영 모니터링)
  usedFallback    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  matches  SdgMatch[]
  contents GeneratedContent[]

  @@index([companyId])
  @@index([createdAt])
}

model SdgMatch {
  id         String   @id @default(cuid())
  analysisId String
  sdg        SdgGoal
  score      Int
  /// string[] JSON 직렬화
  keywords   String
  rationale  String
  createdAt  DateTime @default(now())

  analysis SdgAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@unique([analysisId, sdg])
  @@index([analysisId])
}

model GeneratedContent {
  id            String      @id @default(cuid())
  analysisId    String
  type          ContentType
  /// 콘텐츠가 집중하는 SDG (#92 — 사용자가 분석 매칭 중 단일 선택). 구버전 행은 NULL.
  focusSdg      SdgGoal?
  /// 생성 세부 설정 JSON (#104 — platform/aspectRatio/imageStyle/slideCount/extraRequest). 구버전 행은 NULL.
  options       String?
  body          String
  /// string[] JSON 직렬화
  hashtags      String
  imagePrompt   String?
  editedByUser  Boolean     @default(false)
  usedFallback  Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  analysis SdgAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([type])
}
